
<style>
  .form-card {
    max-width: 720px;
    margin: 40px auto;
    padding: 32px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .form-title {
    margin-top: 0;
    margin-bottom: 24px;
    color: #1a202c;
    font-size: 1.5rem;
    font-weight: 700;
    border-bottom: 2px solid #edf2f7;
    padding-bottom: 12px;
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-label {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    color: #2d3748;
    margin-bottom: 8px;
  }

  /* 普通输入框样式 */
  .form-control {
    width: 100%;
    padding: 12px 16px;
    font-size: 1rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    box-sizing: border-box;
    transition: all 0.2s ease;
    outline: none;
    color: #4a5568;
  }

  .form-control:focus {
    border-color: #3182ce;
    box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15);
  }

  /* 富文本编辑器样式优化 */
  trix-editor {
    min-height: 300px !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 8px !important;
    padding: 16px !important;
    background: #fff;
    font-size: 1rem;
    line-height: 1.6;
  }

  trix-editor:focus {
    border-color: #3182ce !important;
    box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15) !important;
    outline: none;
  }

  /* 错误提示框样式 */
  .error-alert {
    background-color: #fff5f5;
    border-left: 4px solid #fc8181;
    color: #c53030;
    padding: 16px 20px;
    border-radius: 6px;
    margin-bottom: 24px;
  }

  .error-alert h4 {
    margin: 0 0 8px 0;
    font-size: 1rem;
  }

  .error-alert ul {
    margin: 0;
    padding-left: 20px;
    font-size: 0.95rem;
  }

  /* 提交按钮区域 */
  .form-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
  }

  .btn-primary {
    background-color: #3182ce;
    color: white;
    padding: 12px 28px;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .btn-primary:hover {
    background-color: #2b6cb0;
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-cancel {
    color: #718096;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .btn-cancel:hover {
    color: #2d3748;
  }
</style>

<!-- 3. 表单结构 -->
<div class="form-card">
  <h2 class="form-title">📝 撰写文章</h2>
  
  <%= form_with(model: article) do |form| %>

    <% if article.errors.any? %>
      <div class="error-alert">
        <h4>提交失败，存在以下 <%= article.errors.count %> 个问题：</h4>
        <ul>
          <% article.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- 文章标题区块 -->
    <div class="form-group">
      <%= form.label :title, "文章标题", class: "form-label" %>
      <%= form.text_field :title, class: "form-control", placeholder: "给文章起个响亮的标题..." %>
    </div>

    <!-- 文章正文（富文本）区块 -->
    <div class="form-group">
      <%= form.label :rich_content, "文章正文", class: "form-label" %>
      <span style="font-size: 0.85rem; color: #a0aec0; margin-bottom: 8px; display: block;">
        💡 提示：支持直接从电脑桌面拖拽图片到下方输入框内
      </span>
      <%= form.rich_text_area :rich_content %>
    </div>

    <!-- 提交操作区块 -->
    <div class="form-actions">
      <%= form.submit "保存文章", class: "btn-primary" %>
      <%= link_to "取消并返回列表", articles_path, class: "btn-cancel" %>
    </div>

  <% end %>
</div>