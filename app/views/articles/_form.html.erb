<main class="article-form-page">
<div class="form-card">
  <div class="form-heading">
    <span class="form-heading-icon" aria-hidden="true">✦</span>
    <div>
      <h1 class="form-title"><%= article.persisted? ? "编辑文章" : "发布新文章" %></h1>
      <p class="form-subtitle">记录想法，也可以只分享一张图片</p>
    </div>
  </div>
  
  <%= form_with(model: article) do |form| %>

    <% if article.errors.any? %>
      <div class="error-alert">
        <h2>暂时无法保存</h2>
        <ul>
          <% article.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :title, class: "form-label" do %>
        文章标题 <span class="required-mark">必填</span>
      <% end %>
      <%= form.text_field :title, class: "form-control", placeholder: "给文章起一个标题", autofocus: true %>
    </div>

    <div class="form-group">
      <%= form.label :rich_content, "文章正文", class: "form-label" %>
      <p class="form-help">正文可留空；可拖入图片或点击工具栏回形针，支持纯图片发布。</p>
      <%= form.rich_text_area :rich_content, class: "article-editor", placeholder: "写下你的故事……" %>
    </div>

    <div class="form-actions">
      <%= form.submit article.persisted? ? "保存修改" : "发布文章", class: "btn-primary" %>
      <%= link_to "取消", articles_path, class: "btn-cancel" %>
    </div>

  <% end %>
</div>
</main>
