<main class="article-container">
  <article class="article-sheet">
    <header class="article-header">
      <span class="page-eyebrow">JOURNAL ENTRY</span>
      <h1 class="article-title"><%= @article.title %></h1>
      <div class="article-meta-row">
        <time datetime="<%= @article.created_at.iso8601 %>"><%= @article.created_at.strftime("%Y年%m月%d日 · %H:%M") %></time>
        <span class="article-meta-dot">•</span>
        <span>一篇生活札记</span>
      </div>
      <nav class="article-actions" aria-label="文章操作">
        <%= link_to "编辑文章", edit_article_path(@article) %>
        <%= link_to "返回列表", articles_path %>
        <%= button_to "删除文章", article_path(@article), method: :delete,
              form: { data: { turbo_confirm: "确定要删除这篇文章吗？" } },
              class: "action-delete" %>
      </nav>
    </header>

    <div class="article-body trix-content">
      <% if @article.cover_image.attached? %>
        <%= image_tag @article.cover_image, alt: @article.title, class: "article-cover" %>
      <% end %>
      <%= @article.rich_content %>
    </div>
  </article>

  <section class="comments-section">
    <div class="section-heading">
      <div>
        <span class="page-eyebrow">CONVERSATION</span>
        <h2>评论 <small><%= @article.comments.count %></small></h2>
      </div>
    </div>

    <% if @article.comments.any? %>
      <div class="comment-list">
        <% @article.comments.each do |comment| %>
          <% next if comment.new_record? %>
          <article class="comment-card">
            <div class="comment-avatar"><%= comment.commenter.to_s.first&.upcase || "访" %></div>
            <div class="comment-content">
              <div class="comment-meta">
                <strong><%= comment.commenter %></strong>
                <time><%= comment.created_at.strftime("%Y-%m-%d %H:%M") %></time>
              </div>
              <p class="comment-text"><%= comment.body %></p>
              <%= button_to "删除", article_comment_path(@article, comment), method: :delete,
                    form: { data: { turbo_confirm: "确定删除这条评论吗？" } },
                    class: "btn-delete-comment" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="comments-empty">这里还很安静，来留下第一句话吧。</p>
    <% end %>

    <div class="comment-form-section">
      <h3>写下你的回应</h3>
      <%= form_with(model: [@article, @article.comments.build]) do |form| %>
        <div class="comment-form-grid">
          <div class="form-group">
            <%= form.label :commenter, "昵称", class: "form-label" %>
            <%= form.text_field :commenter, required: true, class: "form-control", placeholder: "怎么称呼你？" %>
          </div>
          <div class="form-group comment-message-field">
            <%= form.label :body, "评论内容", class: "form-label" %>
            <%= form.text_area :body, rows: 4, required: true, class: "form-control", placeholder: "说点什么吧……" %>
          </div>
        </div>
        <%= form.submit "发表评论", class: "btn-primary" %>
      <% end %>
    </div>
  </section>
</main>
