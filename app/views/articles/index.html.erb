<main class="blog-container">
  <header class="blog-header">
    <div>
      <span class="page-eyebrow">MY JOURNAL</span>
      <h1 class="blog-title">慢慢写，慢慢生活</h1>
      <p class="blog-intro">收藏微小而闪亮的日常，也记录每一次认真思考。</p>
    </div>
    <%= link_to "发布新文章", new_article_path, class: "btn-new" %>
  </header>

  <section class="search-container" aria-label="搜索文章">
    <%= form_with url: articles_path, method: :get, local: true, class: "search-form" do |form| %>
      <%= form.text_field :query, value: params[:query], placeholder: "输入关键词搜索文章", class: "search-input" %>
      <%= form.submit "搜索", class: "btn-search" %>
      <%= link_to "清空", articles_path, class: "btn-clear" if params[:query].present? %>
    <% end %>
  </section>

  <section class="article-list" aria-label="文章列表">
    <% if @articles.any? %>
      <% @articles.each do |article| %>
        <% preview_image = article_preview_image(article) %>
        <% summary = article.rich_content.to_plain_text.strip.presence || article.content.to_s.strip %>

        <%= link_to article_path(article), class: "article-card-link" do %>
          <article class="article-card <%= "article-card--without-image" unless preview_image %>">
            <% if preview_image %>
              <div class="article-card-media">
                <%= image_tag preview_image, alt: article.title, loading: "lazy" %>
              </div>
            <% end %>

            <div class="article-card-content">
              <div class="article-title-text"><%= article.title %></div>
              <div class="article-meta">发布于 <%= article.created_at.strftime("%Y-%m-%d %H:%M") %></div>
              <% if summary.present? %>
                <p class="article-summary"><%= truncate(summary, length: 120) %></p>
              <% elsif preview_image %>
                <p class="article-summary article-summary--image">图片文章</p>
              <% end %>
            </div>
          </article>
        <% end %>
      <% end %>
    <% else %>
      <div class="empty-state">
        <h2>没有找到相关文章</h2>
        <p>换个关键词试试，或者现在发布一篇新文章。</p>
      </div>
    <% end %>
  </section>

  <% if @total_pages > 1 %>
    <nav class="pagination" aria-label="文章分页">
      <% if @page > 1 %>
        <%= link_to "上一页", articles_path(query: params[:query], page: @page - 1), class: "pagination-link pagination-direction" %>
      <% else %>
        <span class="pagination-link pagination-direction is-disabled" aria-disabled="true">上一页</span>
      <% end %>

      <div class="pagination-pages">
        <% (1..@total_pages).each do |page_number| %>
          <% if page_number == @page %>
            <span class="pagination-link is-current" aria-current="page"><%= page_number %></span>
          <% else %>
            <%= link_to page_number, articles_path(query: params[:query], page: page_number), class: "pagination-link" %>
          <% end %>
        <% end %>
      </div>

      <% if @page < @total_pages %>
        <%= link_to "下一页", articles_path(query: params[:query], page: @page + 1), class: "pagination-link pagination-direction" %>
      <% else %>
        <span class="pagination-link pagination-direction is-disabled" aria-disabled="true">下一页</span>
      <% end %>
    </nav>
  <% end %>
</main>
